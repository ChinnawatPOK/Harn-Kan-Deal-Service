# copy to .env (git-ignored). Used by docker compose.
# Start ../docker-dependencies first (MySQL + RabbitMQ).
# zone of the Payment Service JVM (its reserved_until has no zone)
PAYMENT_SERVICE_TIMEZONE=UTC
# where Payment runs; host.docker.internal = on this machine (IDE or its own container)
PAYMENT_SERVICE_HOST=host.docker.internal
PAYMENT_SERVICE_PORT=9091
# must match ../docker-dependencies/.env
MYSQL_ROOT_PASSWORD=password
RABBITMQ_USER=harnkan
RABBITMQ_PASSWORD=harnkan
